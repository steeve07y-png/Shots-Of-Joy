# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# Nothing in here may be duplicated into HTML, CSS or frontend JavaScript.
# ---------------------------------------------------------------------------

# Where enquiries are delivered.
# This is the only place the recipient address lives.
CONTACT_RECEIVER=odds.shotsofjoy@gmail.com

# --- SMTP transport -------------------------------------------------------
# For Gmail, SMTP_PASS must be a 16-character App Password (Google Account ->
# Security -> 2-Step Verification -> App passwords), NOT your login password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Envelope From. Many providers require this to match SMTP_USER.
SMTP_FROM="Shots of Joy <your_email@gmail.com>"

# --- Server ---------------------------------------------------------------
PORT=3000

# Comma-separated list of origins allowed to call the API.
# The server also serves the site itself, in which case requests are
# same-origin and this list is not consulted.
# Leave BLANK during local development and these are allowed automatically:
#   localhost / 127.0.0.1 on ports 3000, 5500 (Live Server), 5173, 8080, 8000
# Set it explicitly in production to lock the API down to your real domain.
# ALLOWED_ORIGINS=https://shotsofjoy.example
